# Environment file for CLIProxyAPI LAN Account Manager
# Location: /etc/cliproxyapi-account-manager/manager.env
# Permissions: 0640 (owner root:cliproxyapi)

PORT=8320
HOST=127.0.0.1
NODE_ENV=production

# Leave blank to enable first-time setup on web browser at http://192.168.1.133:8320
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# CLIProxyAPI Local Integration
CLIPROXYAPI_URL=http://127.0.0.1:8317
AUTH_DIR=/var/lib/cliproxyapi/auths
DATA_DIR=/var/lib/cliproxyapi-account-manager
AUDIT_LOG_PATH=/var/log/cliproxyapi-account-manager/audit.log

SESSION_TTL_MINUTES=120
COOKIE_SECURE=false
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=60
