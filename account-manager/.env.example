# CLIProxyAPI Account Manager Environment Configuration
# LAN Account Manager for CLIProxyAPI v8.0.61

# Account Manager Server Settings
PORT=8320
HOST=0.0.0.0
NODE_ENV=production

# Admin Authentication (Change on first run or initialize via /api/setup)
# If ADMIN_PASSWORD_HASH is unset, the first visit prompts for initial admin setup.
# Format: scrypt:<salt_hex>:<hash_hex>
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Session Security
SESSION_TTL_MINUTES=120
COOKIE_SECURE=false

# CLIProxyAPI Backend Integration
# On TX3, Account Manager and CLIProxyAPI run on the same host (127.0.0.1)
CLIPROXYAPI_URL=http://127.0.0.1:8317
CLIPROXYAPI_MANAGEMENT_KEY=

# Local Filesystem Credential Mode (Direct Local Auth Store)
# When Account Manager runs directly on TX3 with access to /var/lib/cliproxyapi/auths
AUTH_DIR=/var/lib/cliproxyapi/auths
CLIPROXYAPI_BIN=/usr/local/bin/cliproxyapi
CLIPROXYAPI_SERVICE=cliproxyapi

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=60
